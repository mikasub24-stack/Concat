# Maintainer: noxygalaxy <noxycraftyt@gmail.com>
pkgname=mika-studio
pkgver=${CONCAT_VERSION:?CONCAT_VERSION must be set}
pkgrel=1
pkgdesc="Free and open source video editor, based on Concat"
arch=('x86_64' 'aarch64')
url="${MIKA_STUDIO_HOMEPAGE:-https://github.com/jub0t/Concat}"
license=('AGPL-3.0-or-later')
depends=('glibc' 'gtk3' 'fontconfig' 'freetype2' 'libxkbcommon' 'mesa' 'alsa-lib')
options=('!strip' '!debug')
source=()

stage=${CONCAT_STAGE:?CONCAT_STAGE must point at the staged folder}

package() {
  install -Dm755 "$stage/concat" "$pkgdir/opt/mika-studio/concat"
  install -d "$pkgdir/opt/mika-studio/lib"
  cp -a "$stage"/lib/. "$pkgdir/opt/mika-studio/lib/"

  install -d "$pkgdir/usr/bin"
  printf '#!/bin/sh\nexec /opt/mika-studio/concat "$@"\n' > "$pkgdir/usr/bin/mika-studio"
  chmod 755 "$pkgdir/usr/bin/mika-studio"
  install -Dm644 "$stage/concat.desktop" "$pkgdir/usr/share/applications/mika-studio.desktop"
  sed -i 's|^Exec=concat|Exec=/opt/mika-studio/concat %U|' "$pkgdir/usr/share/applications/mika-studio.desktop"
  install -Dm644 "$stage/concat.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/mika-studio.png"

  install -Dm644 "$stage/LICENSE" "$pkgdir/usr/share/licenses/mika-studio/LICENSE"
  install -Dm644 "$stage/THIRD_PARTY_NOTICES.md" "$pkgdir/usr/share/licenses/mika-studio/THIRD_PARTY_NOTICES.md"
}
